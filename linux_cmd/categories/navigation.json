  {
    "id": "cmd-251",
    "command": "pushd /var/log",
    "category": "Navigation",
    "description": "Changes to /var/log and adds current directory to stack.",
    "example_output": "~/var/log ~",
    "man_reference": "https://man7.org/linux/man-pages/man1/pushd.1.html"
  },
  {
    "id": "cmd-252",
    "command": "popd",
    "category": "Navigation",
    "description": "Returns to the directory at the top of the stack.",
    "example_output": "~",
    "man_reference": "https://man7.org/linux/man-pages/man1/popd.1.html"
  },
  {
    "id": "cmd-253",
    "command": "dirs -v",
    "category": "Navigation",
    "description": "Displays the directory stack with indices vertically.",
    "example_output": "0 /var/log\n1 ~",
    "man_reference": "https://man7.org/linux/man-pages/man1/dirs.1.html"
  },
  {
    "id": "cmd-351",
    "command": "pushd +2",
    "category": "Navigation",
    "description": "Rotates the directory stack to make the third entry the current directory.",
    "example_output": "~/dir3 ~/dir1 ~/dir2",
    "man_reference": "https://man7.org/linux/man-pages/man1/pushd.1.html"
  },
  {
    "id": "cmd-352",
    "command": "dirs -c",
    "category": "Navigation",
    "description": "Clears the directory stack.",
    "example_output": "[No output, stack cleared]",
    "man_reference": "https://man7.org/linux/man-pages/man1/dirs.1.html"
  },
  {
    "id": "cmd-353",
    "command": "cd -P /path/to/symlink",
    "category": "Navigation",
    "description": "Changes to the physical directory resolved from /path/to/symlink.",
    "example_output": "[No output, changes directory]",
    "man_reference": "https://man7.org/linux/man-pages/man1/cd.1.html"
  },
  {
    "id": "cmd-451",
    "command": "cd /proc/$$",
    "category": "Navigation",
    "description": "Changes to the /proc directory of the current shell process.",
    "example_output": "[No output, changes to /proc/<pid>]",
    "man_reference": "https://man7.org/linux/man-pages/man5/proc.5.html"
  },
  {
    "id": "cmd-452",
    "command": "dirs -p",
    "category": "Navigation",
    "description": "Displays directory stack one entry per line.",
    "example_output": "~/dir1\n~/dir2",
    "man_reference": "https://man7.org/linux/man-pages/man1/dirs.1.html"
  },
  {
    "id": "cmd-453",
    "command": "pushd -n /tmp",
    "category": "Navigation",
    "description": "Adds /tmp to directory stack without changing current directory.",
    "example_output": "~/tmp ~",
    "man_reference": "https://man7.org/linux/man-pages/man1/pushd.1.html"
  },
  {
    "id": "cmd-454",
    "command": "cd /dev/shm",
    "category": "Navigation",
    "description": "Changes to the shared memory filesystem directory.",
    "example_output": "[No output, changes to /dev/shm]",
    "man_reference": "https://man7.org/linux/man-pages/man5/shm.5.html"
  },
  {
    "id": "cmd-455",
    "command": "tree -if --noreport /etc | grep '\\.conf$'",
    "category": "Navigation",
    "description": "Lists all .conf files in /etc without directory tree formatting.",
    "example_output": "/etc/nginx/nginx.conf\n/etc/sshd/sshd.conf",
    "man_reference": "https://man7.org/linux/man-pages/man1/tree.1.html"
  }
]
